# サイト
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DB の TLS 設定（既定は証明書を検証する verify-full。localhost は TLS なし）
# 検証用 CA を明示する場合のみ設定する
DATABASE_CA_CERT=
# 例外的に検証を緩める場合のみ設定する（verify-full | require | prefer | allow）
DATABASE_SSL_MODE=

# 管理画面 /admin にアクセスできるログイン済みユーザーのメール（カンマ区切り）
ADMIN_EMAILS=

# 監視
SENTRY_DSN=
