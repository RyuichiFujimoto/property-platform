# サイト
# 本番ビルド・実行環境では公開サイトの絶対 URL を必ず設定する（例: https://example.com）。
# localhost はローカル開発用。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ローカル開発・プレビュー専用。本番では true にしてもサンプルデータは公開されない。
ALLOW_PREVIEW_DATA=false

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DB の TLS 設定（既定は証明書を検証する verify-full。localhost は TLS なし）
# 検証用 CA を明示する場合のみ設定する
DATABASE_CA_CERT=
# 例外的に検証を緩める場合のみ設定する（verify-full | require | prefer | allow）
DATABASE_SSL_MODE=

# 管理画面 /admin にアクセスできるログイン済みユーザーのメール（カンマ区切り）
ADMIN_EMAILS=

# 監視
SENTRY_DSN=
